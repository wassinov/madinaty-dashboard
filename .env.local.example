# ============================================================
# Madinaty Dashboard — exemple de configuration
# ============================================================
# 1. Copier ce fichier en .env.local
# 2. Remplir avec les clés de votre projet Supabase
# 3. Ne JAMAIS committer .env.local (déjà ignoré par .gitignore)
#
# Récupération des clés :
#   https://supabase.com > Project Settings > API
# ============================================================

# URL du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé anonyme ( publique ) — utilisée côté client
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxx

# Clé service_role ( SECRÈTE ) — utilisée côté serveur uniquement, pour la
# création de comptes via /admin/utilisateurs ( Server Actions ).
#  Récupération :  Project Settings > API > service_role (ou service_legacy)
#  ATTENTION : ne JAMAIS rendre cette clé publique côté navigateur.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxx
